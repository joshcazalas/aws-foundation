# Copy this file to personal.auto.tfvars, replace both values, and chmod it 600.
# personal.auto.tfvars is ignored by Git. Never commit real account addresses.
workload_account_emails = {
  money-on-record-uat  = "replace-with-existing-uat-account-alias@example.invalid"
  money-on-record-prod = "replace-with-existing-prod-account-alias@example.invalid"
}
